FROM python:3.13-slim
WORKDIR /app/

# Сначала ставим зависимости (кэшируется при изменении кода)
#поэтому нельзя скопировать сначала все три сразу
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app 
COPY models ./models

EXPOSE 8000 
#Приложение внутри этого контейнера будет слушать 8000-й порт
#"--host", "0.0.0.0" — сетевой интерфейс, на котором uvicorn принимает запросы.
#0.0.0.0 означает «принимать соединения со всех сетевых интерфейсов», включая виртуальный мост Docker, через который стучится твой браузер или curl.
#"--port", "8000" — порт внутри контейнера, на котором uvicorn будет ждать HTTP-запросы 
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]